# Configure — get these with `npx configure setup` or from https://configure.dev
CONFIGURE_API_KEY=sk_...
CONFIGURE_PUBLISHABLE_KEY=pk_...
CONFIGURE_AGENT=your-agent

# Photon / Spectrum — get these from https://app.photon.codes
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Optional: override the routed iMessage line when Spectrum cannot expose space.phone.
# Otherwise the adapter uses Spectrum's current line and registers it with Configure at link time.
AGENT_PHONE_NUMBER=

# Model provider — used by the sample handler. Swap agent.ts to your provider of choice.
MODEL_API_KEY=...
MODEL_NAME=...
